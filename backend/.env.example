# Gemini API key for the Genkit googleAI() plugin (docs/local-setup.md's
# Secrets section: get your own from https://aistudio.google.com/apikey).
# Not needed to run `pnpm test` — tests use a Genkit mock model instead.
GEMINI_API_KEY=

# Gemini model /api/chat talks to. Unset, /api/chat tries the production
# ladder of models (two Flash-Lite, then Flash) in turn when one fails
# (GEMINI_MODEL_LADDER in src/config.ts). Set, it talks to that one model
# only, retrying it but never switching: e.g. gemini-3.5-flash-lite to try
# one Flash-Lite model on its own.
# GEMINI_MODEL=

# Comma-separated list of origins hono/cors should allow. Defaults to
# localhost:5173 (frontend dev server) + the deployed Firebase Hosting
# origin — only set this to override, e.g. testing a different frontend port.
# CORS_ORIGIN=

# /api/chat requires a Firebase App Check token (docs/contracts.md). Set to
# exactly "off" to skip that check, e.g. to curl /api/chat locally. Local
# development only: any other value, or leaving it unset, keeps it on, and
# the server refuses to start with it on Cloud Run.
# APP_CHECK=off

# Base URL of Inference's /analyze service. Unused until TASK-11: until
# then analyze_pun answers from a fixture. Defaults to localhost:8000.
# INFERENCE_URL=
